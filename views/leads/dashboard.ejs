<%- include('../base-pm', {
    title: 'Leads',
    description: 'Manage leads and intake forms'
}) %>

<%- include('../partials/pm-nav') %>

<link href="/css/skeleton.css" rel="stylesheet">
<style>
    .bulk-toolbar {
        display: none;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: #fff;
        padding: 10px 20px;
        border-radius: 8px;
        margin-bottom: 16px;
        align-items: center;
        gap: 12px;
    }
    .bulk-toolbar.active { display: flex; }
    tr.row-selected { background-color: #e8f0fe !important; }
    .checkbox-cell { width: 40px; text-align: center; }
</style>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2><i class="fas fa-user-plus me-2"></i>Leads</h2>
            <p class="text-muted mb-0">Manage your potential clients</p>
        </div>
        <div>
            <a href="/leads/forms" class="btn btn-outline-secondary me-2">
                <i class="fas fa-file-alt me-1"></i>Intake Forms
            </a>
            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#newLeadModal">
                <i class="fas fa-plus me-1"></i>New Lead
            </button>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="row mb-4">
        <div class="col-md-2">
            <div class="card bg-primary text-white">
                <div class="card-body text-center">
                    <h3 class="mb-0"><%= stats.total || 0 %></h3>
                    <small>Total Leads</small>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card bg-info text-white">
                <div class="card-body text-center">
                    <h3 class="mb-0"><%= stats.new_count || 0 %></h3>
                    <small>New</small>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card bg-warning text-dark">
                <div class="card-body text-center">
                    <h3 class="mb-0"><%= stats.contacted_count || 0 %></h3>
                    <small>Contacted</small>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card bg-secondary text-white">
                <div class="card-body text-center">
                    <h3 class="mb-0"><%= stats.qualified_count || 0 %></h3>
                    <small>Qualified</small>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card bg-success text-white">
                <div class="card-body text-center">
                    <h3 class="mb-0"><%= stats.converted_count || 0 %></h3>
                    <small>Converted</small>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card bg-dark text-white">
                <div class="card-body text-center">
                    <h3 class="mb-0"><%= stats.this_week || 0 %></h3>
                    <small>This Week</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Filters -->
    <div class="card mb-4">
        <div class="card-body">
            <form method="GET" class="row g-3">
                <div class="col-md-3">
                    <select name="status" class="form-select">
                        <option value="all">All Status</option>
                        <option value="new" <%= filters.status === 'new' ? 'selected' : '' %>>New</option>
                        <option value="contacted" <%= filters.status === 'contacted' ? 'selected' : '' %>>Contacted</option>
                        <option value="qualified" <%= filters.status === 'qualified' ? 'selected' : '' %>>Qualified</option>
                        <option value="converted" <%= filters.status === 'converted' ? 'selected' : '' %>>Converted</option>
                        <option value="lost" <%= filters.status === 'lost' ? 'selected' : '' %>>Lost</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <select name="practice_area" class="form-select">
                        <option value="all">All Practice Areas</option>
                        <option value="personal_injury">Personal Injury</option>
                        <option value="family">Family Law</option>
                        <option value="criminal">Criminal Defense</option>
                        <option value="corporate">Corporate</option>
                        <option value="estate">Estate Planning</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <select name="source" class="form-select">
                        <option value="all">All Sources</option>
                        <option value="website">Website</option>
                        <option value="referral">Referral</option>
                        <option value="advertisement">Advertisement</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fas fa-filter me-1"></i>Filter
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Bulk Action Toolbar -->
    <div class="bulk-toolbar" id="bulkToolbar">
        <span class="bulk-count"><span id="selectedCount">0</span> selected</span>
        <div class="dropdown">
            <button class="btn btn-sm btn-light dropdown-toggle" data-bs-toggle="dropdown">
                <i class="fas fa-edit me-1"></i>Update Status
            </button>
            <ul class="dropdown-menu">
                <li><a class="dropdown-item" href="#" onclick="bulkUpdate('new')">New</a></li>
                <li><a class="dropdown-item" href="#" onclick="bulkUpdate('contacted')">Contacted</a></li>
                <li><a class="dropdown-item" href="#" onclick="bulkUpdate('qualified')">Qualified</a></li>
                <li><a class="dropdown-item" href="#" onclick="bulkUpdate('lost')">Lost</a></li>
            </ul>
        </div>
        <button class="btn btn-sm btn-danger" onclick="bulkDeleteLeads()">
            <i class="fas fa-trash me-1"></i>Delete Selected
        </button>
        <button class="btn btn-sm btn-outline-light ms-auto" onclick="clearSelection()">
            <i class="fas fa-times me-1"></i>Clear
        </button>
    </div>

    <!-- Skeleton Loading -->
    <%- include('../partials/skeleton-table', { skeletonRows: 8 }) %>

    <!-- Leads Table -->
    <div class="card" id="leadsTableCard">
        <div class="card-body">
            <% if (leads.length > 0) { %>
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th class="checkbox-cell">
                                <input type="checkbox" class="form-check-input" id="selectAll" title="Select All">
                            </th>
                            <th>Name</th>
                            <th>Contact</th>
                            <th>Practice Area</th>
                            <th>Source</th>
                            <th>Status</th>
                            <th>Date</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% leads.forEach(lead => { %>
                        <tr class="clickable-row" data-href="/leads/<%= lead.id %>" style="cursor: pointer;">
                            <td class="checkbox-cell actions-cell" onclick="event.stopPropagation();">
                                <input type="checkbox" class="form-check-input row-checkbox" data-id="<%= lead.id %>">
                            </td>
                            <td>
                                <strong><%= lead.first_name %> <%= lead.last_name %></strong>
                                <% if (lead.company) { %><br><small class="text-muted"><%= lead.company %></small><% } %>
                            </td>
                            <td>
                                <a href="mailto:<%= lead.email %>" onclick="event.stopPropagation();"><%= lead.email %></a>
                                <% if (lead.phone) { %><br><small><%= lead.phone %></small><% } %>
                            </td>
                            <td><span class="badge bg-secondary"><%= lead.practice_area || 'N/A' %></span></td>
                            <td><%= lead.source || 'N/A' %></td>
                            <td>
                                <span class="badge bg-<%= lead.status === 'new' ? 'info' : lead.status === 'converted' ? 'success' : lead.status === 'lost' ? 'danger' : 'warning' %>">
                                    <%= lead.status %>
                                </span>
                            </td>
                            <td><%= new Date(lead.created_at).toLocaleDateString() %></td>
                            <td class="actions-cell" onclick="event.stopPropagation();">
                                <a href="/leads/<%= lead.id %>" class="btn btn-sm btn-outline-primary me-1">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <button class="btn btn-sm btn-outline-danger btn-delete" data-id="<%= lead.id %>" data-name="<%= lead.first_name %> <%= lead.last_name %>">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
            <% } else { %>
            <div class="text-center py-5">
                <i class="fas fa-user-plus fa-3x text-muted mb-3"></i>
                <h5>No Leads Found</h5>
                <p class="text-muted">Create an intake form to start capturing leads.</p>
                <a href="/leads/forms" class="btn btn-primary">
                    <i class="fas fa-plus me-1"></i>Create Intake Form
                </a>
            </div>
            <% } %>
        </div>
    </div>
</div>

<!-- New Lead Modal -->
<div class="modal fade" id="newLeadModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-user-plus me-2"></i>New Lead</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="newLeadForm">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">First Name *</label>
                            <input type="text" name="first_name" class="form-control" required>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Last Name *</label>
                            <input type="text" name="last_name" class="form-control" required>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Email *</label>
                            <input type="email" name="email" class="form-control" required>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Phone</label>
                            <input type="tel" name="phone" class="form-control">
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Source</label>
                            <select name="source" class="form-select">
                                <option value="manual">Manual Entry</option>
                                <option value="referral">Referral</option>
                                <option value="website">Website</option>
                                <option value="phone">Phone Call</option>
                                <option value="walk_in">Walk-in</option>
                                <option value="other">Other</option>
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Practice Area</label>
                            <select name="practice_area" class="form-select">
                                <option value="">Not Specified</option>
                                <option value="family">Family Law</option>
                                <option value="personal_injury">Personal Injury</option>
                                <option value="criminal">Criminal Defense</option>
                                <option value="estate">Estate Planning</option>
                                <option value="corporate">Corporate</option>
                                <option value="real_estate">Real Estate</option>
                                <option value="immigration">Immigration</option>
                                <option value="bankruptcy">Bankruptcy</option>
                            </select>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Notes / Message</label>
                        <textarea name="message" class="form-control" rows="3" placeholder="Enter any notes about the lead..."></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="createLead()">
                    <i class="fas fa-save me-1"></i>Create Lead
                </button>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/confirmation-modal') %>

<script src="/js/confirmation-dialog.js"></script>
<script>
// Hide skeleton on load
document.addEventListener('DOMContentLoaded', function() {
    var skeleton = document.getElementById('skeletonTable');
    if (skeleton) skeleton.style.display = 'none';
});

// Create new lead
async function createLead() {
    const form = document.getElementById('newLeadForm');
    const formData = new FormData(form);
    const data = Object.fromEntries(formData.entries());

    if (!data.first_name || !data.last_name || !data.email) {
        alert('Please fill in all required fields');
        return;
    }

    try {
        const response = await fetch('/api/leads', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        });
        const result = await response.json();
        if (result.success) {
            window.location.reload();
        } else {
            alert('Error: ' + (result.error || 'Failed to create lead'));
        }
    } catch (error) {
        console.error('Create lead error:', error);
        alert('Failed to create lead');
    }
}

// Row click handler
document.querySelectorAll('.clickable-row').forEach(function(row) {
    row.addEventListener('click', function(e) {
        if (e.target.closest('.actions-cell') || e.target.closest('button') || e.target.closest('a') || e.target.closest('input[type="checkbox"]')) return;
        window.location.href = this.dataset.href;
    });
});

// Select All
document.getElementById('selectAll')?.addEventListener('change', function() {
    var checked = this.checked;
    document.querySelectorAll('.row-checkbox').forEach(function(cb) {
        cb.checked = checked;
        cb.closest('tr').classList.toggle('row-selected', checked);
    });
    updateBulkToolbar();
});

// Individual checkboxes
document.querySelectorAll('.row-checkbox').forEach(function(cb) {
    cb.addEventListener('change', function() {
        this.closest('tr').classList.toggle('row-selected', this.checked);
        var allChecked = document.querySelectorAll('.row-checkbox').length === document.querySelectorAll('.row-checkbox:checked').length;
        var selectAll = document.getElementById('selectAll');
        if (selectAll) selectAll.checked = allChecked;
        updateBulkToolbar();
    });
});

function updateBulkToolbar() {
    var count = document.querySelectorAll('.row-checkbox:checked').length;
    document.getElementById('selectedCount').textContent = count;
    document.getElementById('bulkToolbar').classList.toggle('active', count > 0);
}

function getSelectedIds() {
    return Array.from(document.querySelectorAll('.row-checkbox:checked')).map(function(cb) { return cb.dataset.id; });
}

function clearSelection() {
    document.querySelectorAll('.row-checkbox').forEach(function(cb) {
        cb.checked = false;
        cb.closest('tr').classList.remove('row-selected');
    });
    var selectAll = document.getElementById('selectAll');
    if (selectAll) selectAll.checked = false;
    updateBulkToolbar();
}

// Delete handler with custom dialog
document.querySelectorAll('.btn-delete').forEach(function(btn) {
    btn.addEventListener('click', function(e) {
        e.stopPropagation();
        var id = this.dataset.id;
        var name = this.dataset.name;
        showConfirmDialog({
            title: 'Delete Lead',
            message: 'Are you sure you want to delete lead "' + name + '"?',
            confirmText: 'Delete',
            confirmClass: 'btn-danger',
            onConfirm: function() {
                fetch('/api/leads/' + id, { method: 'DELETE' })
                .then(function(r) { return r.json(); })
                .then(function(result) {
                    if (result.success) location.reload();
                    else alert('Error: ' + (result.error || 'Failed to delete'));
                })
                .catch(function() { alert('Delete failed'); });
            }
        });
    });
});

function bulkDeleteLeads() {
    var ids = getSelectedIds();
    if (ids.length === 0) return;
    showConfirmDialog({
        title: 'Delete ' + ids.length + ' Leads',
        message: 'Are you sure you want to delete ' + ids.length + ' selected lead(s)?',
        confirmText: 'Delete All',
        confirmClass: 'btn-danger',
        onConfirm: function() {
            fetch('/api/leads/bulk-delete', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ ids: ids })
            })
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (data.success) location.reload();
                else alert('Error: ' + (data.error || 'Unknown error'));
            })
            .catch(function(err) { alert('Error: ' + err.message); });
        }
    });
}

function bulkUpdate(status) {
    var ids = getSelectedIds();
    if (ids.length === 0) return;
    fetch('/api/leads/bulk-update', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ ids: ids, updates: { status: status } })
    })
    .then(function(r) { return r.json(); })
    .then(function(data) {
        if (data.success) location.reload();
        else alert('Error: ' + (data.error || 'Unknown error'));
    })
    .catch(function(err) { alert('Error: ' + err.message); });
}
</script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<%- include('../partials/footer') %>
</body>
</html>
