# Copy this file to .env and fill in your actual values

# Database Configuration (REQUIRED)
# Governed production deployments require DATABASE_URL plus verified TLS.
DATABASE_URL=postgresql://legalforms:replace_me@db.example.com:5432/legalforms
DB_SSL_MODE=verify-full
# Use \n escapes when storing a private database CA in a secret manager.
DATABASE_SSL_CA=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=legalforms
DB_USER=postgres
DB_PASSWORD=your_database_password_here

# REQUIRED: OpenRouter API Configuration
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=anthropic/claude-3-haiku

# Server Configuration
PORT=3000
NODE_ENV=development
SITE_URL=http://localhost:3000

# Security Settings (REQUIRED for production)
SESSION_SECRET=your-session-secret-here
JWT_SECRET=replace_with_at_least_32_random_characters
JWT_ISSUER=legalforms
JWT_AUDIENCE=legalforms-governed-api
JWT_EXPIRES_IN=15m
ALLOWED_ORIGINS=https://legal.example.com
GOVERNED_SOURCE_HOSTS=forms.courts.example,templates.legal.example
GOVERNED_MIN_RETENTION_DAYS=2555
# Governed provider gateways are required in production. Each gateway accepts a
# typed POST envelope and returns immutable receipt/digest evidence; keep tokens
# in a secret manager rather than this file.
GOVERNED_STORAGE_URL=https://storage-provider.example.com/governed-events
GOVERNED_STORAGE_TOKEN=replace_with_at_least_32_random_characters
GOVERNED_OCR_URL=https://ocr-provider.example.com/governed-events
GOVERNED_OCR_TOKEN=replace_with_at_least_32_random_characters
GOVERNED_ESIGN_URL=https://esign-provider.example.com/governed-events
GOVERNED_ESIGN_TOKEN=replace_with_at_least_32_random_characters
GOVERNED_FILING_URL=https://filing-provider.example.com/governed-events
GOVERNED_FILING_TOKEN=replace_with_at_least_32_random_characters
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload Settings (Optional)
MAX_FILE_SIZE=10485760
UPLOAD_DIR=uploads

# E-signature Integration (Optional - for DocuSign)
DOCUSIGN_INTEGRATION_KEY=your_docusign_integration_key
DOCUSIGN_USER_ID=your_docusign_user_id
DOCUSIGN_ACCOUNT_ID=your_docusign_account_id
# Option 1: Path to private key file (RECOMMENDED)
# Use either DOCUSIGN_RSA_PRIVATE_KEY_PATH or DOCUSIGN_RSA_PRIVATE_KEY
DOCUSIGN_RSA_PRIVATE_KEY_PATH=/path/to/your/docusign_private.key
# OR use DOCUSIGN_RSA_PRIVATE_KEY for file path (alternative)
# DOCUSIGN_RSA_PRIVATE_KEY=/path/to/your/docusign_private.key
# Option 2: Private key as environment variable (escape newlines with \n)
# DOCUSIGN_RSA_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEpAIBAAKCAQEA...\n-----END RSA PRIVATE KEY-----"
DOCUSIGN_BASE_PATH=https://demo.docusign.net/restapi

# Instructions:
# 1. Copy this file: cp .env.example .env
# 2. Create PostgreSQL database: createdb legalforms
# 3. Apply checksummed migrations: npm run migrate
# 4. Generate unique JWT/session secrets (for example: openssl rand -base64 48)
# 5. Configure exact origins, approved template hosts, and the retention policy
# 6. Run the governed tests: npm run test:governed
# 7. Start the governed API: npm start
# OpenRouter, DocuSign, uploads, and the individual DB_* variables below are
# retained for the unsupported legacy server only.
